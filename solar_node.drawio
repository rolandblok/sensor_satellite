<mxfile host="65bd71144e">
    <diagram name="Solar sensor node" id="solar-node">
        <mxGraphModel dx="1513" dy="1125" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="sensor satellite — solar / supercap power chain" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="50" y="30" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="2 x 5 V panel (parallel) → blocking diodes → 5.5 V 4 F supercap → low-Iq LDO → ESP32-C3 + BME280 + 2.9&quot; e-paper" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="50" y="66" width="900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="zone_harvest" value="HARVEST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#7f6000;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="120" width="330" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="zone_store" value="STORE &amp; PROTECT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1f4e79;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="410" y="120" width="300" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="zone_load" value="REGULATE &amp; LOAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#255d1c;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="740" y="120" width="800" height="640" as="geometry"/>
                </mxCell>
                <mxCell id="sp1" value="&lt;b&gt;SOLAR PANEL 1&lt;/b&gt;&lt;br&gt;5 V / 200 mA / 1 W&lt;br&gt;&lt;font color=&quot;#7f6000&quot;&gt;Voc up to ~6.5 V&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;+&lt;/b&gt; red → D1&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;−&lt;/b&gt; black → GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="170" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sp2" value="&lt;b&gt;SOLAR PANEL 2&lt;/b&gt;&lt;br&gt;5 V / 200 mA / 1 W&lt;br&gt;&lt;font color=&quot;#7f6000&quot;&gt;Voc up to ~6.5 V&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;+&lt;/b&gt; red → D2&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;−&lt;/b&gt; black → GND" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="80" y="320" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;D1&lt;/b&gt; 1N5819&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;band →&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="180" width="80" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d1band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cc0000;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="352" y="180" width="8" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;D2&lt;/b&gt; 1N5819&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;band →&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="280" y="330" width="80" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d2band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cc0000;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="352" y="330" width="8" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="bandnote" value="&lt;b&gt;White band = cathode.&lt;/b&gt; It points&lt;br&gt;away from the panel, toward the cap.&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;drop ~0.3 V · see the BENCH TEST tab&lt;/font&gt;" style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#cc0000;" parent="1" vertex="1">
                    <mxGeometry x="250" y="245" width="230" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="parallel_note" value="&lt;b&gt;PARALLEL&lt;/b&gt; — not series.&lt;br&gt;Series would give ~12 V and&lt;br&gt;destroy the 5.5 V cap.&lt;br&gt;Separate diodes stop a shaded&lt;br&gt;panel sinking the other&#39;s current." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#7f6000;" parent="1" vertex="1">
                    <mxGeometry x="80" y="270" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="railtop" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="546" y="196" width="8" height="8" as="geometry"/>
                </mxCell>
                <mxCell id="raillabel" value="&lt;b&gt;VCAP rail&lt;/b&gt;&amp;nbsp; ~4.6 V charged" style="text;html=1;fontSize=12;align=left;fontColor=#1f4e79;" parent="1" vertex="1">
                    <mxGeometry x="566" y="180" width="200" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="clamp" value="&lt;b&gt;OVERVOLTAGE CLAMP&lt;/b&gt;&lt;br&gt;5.1 V shunt&lt;br&gt;TL431 or 5.1 V zener&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;required — Voc &gt; cap rating&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="250" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cap" value="&lt;b&gt;SUPERCAP&lt;/b&gt;&lt;br&gt;5.5 V   4 F&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;2 x 2.7 V cells in series&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="440" y="380" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="balance" value="&lt;b&gt;CELL BALANCING&lt;/b&gt;&lt;br&gt;2 x 100 kΩ across each cell&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;skip only if the module&lt;br&gt;already has them fitted&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="440" y="500" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="divider" value="&lt;b&gt;VCAP SENSE&lt;/b&gt;&lt;br&gt;1 MΩ / 1 MΩ + 100 nF&lt;br&gt;→ GPIO2 (ADC1)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;2.7 µA bleed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="440" y="620" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ldo" value="&lt;b&gt;LOW-Iq LDO&lt;/b&gt;&lt;br&gt;3.3 V out&lt;br&gt;MCP1700 / TPS7A02&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Iq ≤ 2 µA, dropout &lt; 200 mV&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="780" y="180" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="rail3v3" value="&lt;b&gt;3V3 rail&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;fontColor=#255d1c;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="200" width="100" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="esp" value="&lt;b&gt;ESP32-C3 SuperMini&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;GPIO0  SDA  → BME280&lt;br&gt;GPIO1  SCL  → BME280&lt;br&gt;GPIO2  ADC  ← Vcap&lt;br&gt;GPIO3  DC   → e-paper&lt;br&gt;GPIO4  CLK  → e-paper&lt;br&gt;GPIO5  RST  → e-paper&lt;br&gt;GPIO6  DIN  → e-paper&lt;br&gt;GPIO7  CS   → e-paper&lt;br&gt;GPIO10 BUSY ← e-paper&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;radios never initialised&lt;br&gt;deep sleep between cycles&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="780" y="330" width="290" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bme" value="&lt;b&gt;BME280&lt;/b&gt;&lt;br&gt;I²C @ 0x76&lt;br&gt;T / RH / pressure&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;forced mode, ~0 µA avg&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="330" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="epd" value="&lt;b&gt;2.9&quot; E-PAPER&lt;/b&gt;&lt;br&gt;296 x 128 b/w, SSD1680&lt;br&gt;4-wire SPI (BS = 0)&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;~2.5 s refresh, then 0 mA&lt;br&gt;image held with no power&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="480" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="gnd" value="&lt;b&gt;GND&lt;/b&gt; — common to panels, cap, LDO, MCU, sensor, panel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="80" y="790" width="1320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="e_sp1_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;endArrow=block;" parent="1" source="sp1" target="d1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_sp2_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;endArrow=block;" parent="1" source="sp2" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d1_rail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="d1" target="railtop" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_d2_rail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#d79b00;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="d2" target="railtop" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="420" y="360"/>
                            <mxPoint x="420" y="200"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_rail_clamp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=none;" parent="1" source="railtop" target="clamp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_clamp_cap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=none;" parent="1" source="clamp" target="cap" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_cap_bal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=none;dashed=1;" parent="1" source="cap" target="balance" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_bal_div" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=none;" parent="1" source="balance" target="divider" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_rail_ldo" value="4.6 V → 3.6 V usable" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=block;fontSize=11;verticalAlign=bottom;" parent="1" source="railtop" target="ldo" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_ldo_esp" value="3.3 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=block;fontSize=11;" parent="1" source="ldo" target="esp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_esp_bme" value="I²C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673a6;startArrow=oval;endArrow=block;fontSize=11;" parent="1" source="esp" target="bme" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_esp_epd" value="SPI + BUSY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#9673a6;startArrow=oval;endArrow=block;fontSize=11;" parent="1" source="esp" target="epd" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_div_esp" value="ADC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=block;dashed=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" parent="1" source="divider" target="esp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="notes" value="&lt;b&gt;DESIGN NOTES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Panels in parallel.&lt;/b&gt; Two 5 V panels in series give ~12 V and would destroy a 5.5 V cap.&lt;br&gt;Parallel keeps the voltage and doubles the current: 400 mA in full sun.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. One diode per panel.&lt;/b&gt; D1/D2 block night-time discharge back into the panels &lt;i&gt;and&lt;/i&gt;&lt;br&gt;stop a shaded panel from sinking current from the lit one. A single shared diode does not.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. The clamp is not optional.&lt;/b&gt; A &quot;5 V&quot; panel reaches ~6.5 V open-circuit in bright sun.&lt;br&gt;The cap is rated 5.5 V absolute. Without a shunt clamp, a sunny afternoon with the node&lt;br&gt;asleep will overvolt it.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Usable energy is charge, not ½CV².&lt;/b&gt; The LDO drops out around 3.6 V, so only&lt;br&gt;4 F x (4.6 - 3.6) = 4 C is usable — about 13 J at 3.3 V, not the 60 J the raw cap figure suggests.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Sense divider must be high impedance.&lt;/b&gt; 100 k/100 k bleeds 27 µA — comparable to the&lt;br&gt;whole sleep budget. 1 M/1 M bleeds 2.7 µA; add 100 nF at the tap for the ADC to charge from.&lt;br&gt;&lt;br&gt;&lt;b&gt;6. Charging is fast, harvesting is not.&lt;/b&gt; 4 C at 400 mA is ~10 s of full sun. The design&lt;br&gt;constraint is overcast days and winter, not charge time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="860" width="1320" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="todo" value="&lt;b&gt;MEASURE FIRST&lt;/b&gt;&lt;br&gt;Active current, sleep current and refresh&lt;br&gt;energy are still unmeasured. They decide&lt;br&gt;whether one panel is enough — and whether&lt;br&gt;4 F is too small.&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Do not order parts from this drawing yet.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="620" width="300" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="BENCH TEST — 2 panels" id="bench-test">
        <mxGraphModel dx="774" dy="536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
            <root>
                <mxCell id="b0"/>
                <mxCell id="b1" parent="b0"/>
                <mxCell id="btitle" value="BENCH TEST — two panels: which wire goes where" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="50" y="25" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bsub" value="Stage 1 of bring-up: two panels, two diodes, one supercap. No clamp and no external LDO needed yet." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="50" y="60" width="1000" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="brule" value="&lt;b&gt;THE RULE&lt;/b&gt;&amp;nbsp;&amp;nbsp; Each panel &lt;b&gt;+&lt;/b&gt; → its own diode → &lt;b&gt;VCAP +&lt;/b&gt;.&amp;nbsp;&amp;nbsp; The &lt;b&gt;WHITE BAND is the exit&lt;/b&gt; — away from the panel, toward the cap.&amp;nbsp;&amp;nbsp; The panels merge &lt;b&gt;after&lt;/b&gt; the diodes, never before." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=16;" parent="b1" vertex="1">
                    <mxGeometry x="50" y="100" width="1450" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="bsp1" value="&lt;b&gt;SOLAR PANEL 1&lt;/b&gt;&lt;br&gt;5 V / 200 mA / 1 W&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;~6.5 V open circuit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="190" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bsp1p" value="&lt;b&gt;+&lt;/b&gt; red" style="text;html=1;fontSize=13;fontColor=#cc0000;fontStyle=1;align=left;" parent="b1" vertex="1">
                    <mxGeometry x="306" y="230" width="70" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bsp1m" value="&lt;b&gt;−&lt;/b&gt; black" style="text;html=1;fontSize=13;fontColor=#000000;fontStyle=1;align=left;" parent="b1" vertex="1">
                    <mxGeometry x="306" y="268" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bsp2" value="&lt;b&gt;SOLAR PANEL 2&lt;/b&gt;&lt;br&gt;5 V / 200 mA / 1 W&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;~6.5 V open circuit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="340" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bsp2p" value="&lt;b&gt;+&lt;/b&gt; red" style="text;html=1;fontSize=13;fontColor=#cc0000;fontStyle=1;align=left;" parent="b1" vertex="1">
                    <mxGeometry x="306" y="380" width="70" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bsp2m" value="&lt;b&gt;−&lt;/b&gt; black" style="text;html=1;fontSize=13;fontColor=#000000;fontStyle=1;align=left;" parent="b1" vertex="1">
                    <mxGeometry x="306" y="418" width="80" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="bw_sp1p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#cc0000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="300" y="245" as="sourcePoint"/>
                        <mxPoint x="500" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_sp2p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#cc0000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="300" y="395" as="sourcePoint"/>
                        <mxPoint x="500" y="395" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_sp1m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="300" y="283" as="sourcePoint"/>
                        <mxPoint x="350" y="650" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="350" y="283"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_sp2m" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="300" y="433" as="sourcePoint"/>
                        <mxPoint x="410" y="650" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="410" y="433"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
