                </mxCell>
                <mxCell id="bd2body" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#000000;" parent="b1" vertex="1">
                    <mxGeometry x="500" y="375" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bd2band" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#f0f0f0;" parent="b1" vertex="1">
                    <mxGeometry x="608" y="375" width="14" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bd2a" value="&lt;b&gt;A&lt;/b&gt; plain end&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;← panel 2 +&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="b1" vertex="1">
                    <mxGeometry x="450" y="420" width="110" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bd2k" value="&lt;b&gt;&lt;font color=&quot;#cc0000&quot;&gt;K — WHITE BAND&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;→ VCAP +&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="b1" vertex="1">
                    <mxGeometry x="570" y="420" width="150" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bw_d1k" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="630" y="245" as="sourcePoint"/>
                        <mxPoint x="760" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_d2k" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="630" y="395" as="sourcePoint"/>
                        <mxPoint x="760" y="395" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="760" y="245" as="sourcePoint"/>
                        <mxPoint x="760" y="480" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bnode1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="b1" vertex="1">
                    <mxGeometry x="755" y="240" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="bnode2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="b1" vertex="1">
                    <mxGeometry x="755" y="390" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="bvcaplab" value="&lt;b&gt;VCAP +&lt;/b&gt;&amp;nbsp; both bands land here&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;this is the merge point — the panels never touch each other directly&lt;/font&gt;" style="text;html=1;fontSize=12;align=left;fontColor=#1f4e79;" parent="b1" vertex="1">
                    <mxGeometry x="775" y="188" width="420" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="bcap" value="&lt;b&gt;SUPERCAP&lt;/b&gt;&lt;br&gt;5.5 V / 4 F&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;+&lt;/b&gt; = long lead / marked side&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;polarised — backwards destroys it&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="b1" vertex="1">
                    <mxGeometry x="660" y="480" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bw_capgnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="760" y="590" as="sourcePoint"/>
                        <mxPoint x="760" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bboard" value="&lt;b&gt;ESP32-C3 SuperMini&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;5V&amp;nbsp;&amp;nbsp;pin ← VCAP +&lt;br&gt;GND pin ← GND&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;its onboard regulator makes 3V3,&lt;br&gt;happy from 4.5 to 6.5 V&lt;br&gt;connect last, USB unplugged&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;spacingTop=8;" parent="b1" vertex="1">
                    <mxGeometry x="1140" y="185" width="290" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="bw_board" value="4.5 – 6.5 V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=block;fontSize=11;verticalAlign=bottom;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="765" y="245" as="sourcePoint"/>
                        <mxPoint x="1140" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bw_boardgnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="b1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1400" y="345" as="sourcePoint"/>
                        <mxPoint x="1400" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="bgnd" value="&lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; panel 1 −&amp;nbsp; ·&amp;nbsp; panel 2 −&amp;nbsp; ·&amp;nbsp; cap −&amp;nbsp; ·&amp;nbsp; SuperMini GND&amp;nbsp; ·&amp;nbsp; meter black probe&amp;nbsp;&amp;nbsp; — all one node, no diode in this path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontSize=13;fontColor=#ffffff;align=left;spacingLeft=16;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="650" width="1350" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="bclampnote" value="&lt;b&gt;WHY NO CLAMP YET&lt;/b&gt;&lt;br&gt;The 5.1 V clamp on the main tab is required for &lt;i&gt;unattended&lt;/i&gt;&lt;br&gt;operation, where a sunny afternoon pushes the cap past&lt;br&gt;5.5 V while the node sleeps. Two panels make that faster,&lt;br&gt;not slower. At the bench, with a meter on the cap and you&lt;br&gt;watching it, the clamp is not needed.&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Do not leave this rig in a window unattended.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;dashed=1;" parent="b1" vertex="1">
                    <mxGeometry x="960" y="400" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="bn_twodiodes" value="&lt;b&gt;WHY TWO DIODES, NOT ONE&lt;/b&gt;&lt;br&gt;&lt;br&gt;One shared diode after the merge does the &lt;b&gt;night&lt;/b&gt; job fine: it blocks the cap discharging back into the panels.&lt;br&gt;&lt;br&gt;It does not do the &lt;b&gt;daylight&lt;/b&gt; job. Wired + to +, the panels are one node and must sit at one voltage. The better-lit panel sets it — and holding a solar cell above its own operating point forward-biases it, so it &lt;i&gt;sinks&lt;/i&gt; current instead of sourcing it.&lt;br&gt;&lt;br&gt;Two diodes make each panel one-way: it can give to VCAP, never take from it.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;No extra voltage cost — current still crosses exactly one diode either way.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="710" width="340" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bn_series" value="&lt;b&gt;WHY PARALLEL, NOT SERIES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Voltage.&lt;/b&gt; Series gives ~13 V open circuit into a cap rated 5.5 V absolute. That alone ends it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Shading.&lt;/b&gt; The deeper reason. A series string carries the &lt;i&gt;worst&lt;/i&gt; panel&#39;s current — shade one and both are throttled. In parallel, shading one panel costs you that panel and nothing else. Graceful, not cliff-edge.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Series plus a buck converter is a legitimate design and slightly better in low light. Ruled out here on quiescent current: the budget is ≤2 µA for the whole regulator, and most bucks sit well above that.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="b1" vertex="1">
                    <mxGeometry x="440" y="710" width="340" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bn_band" value="&lt;b&gt;GETTING THE BAND RIGHT&lt;/b&gt;&lt;br&gt;&lt;br&gt;The band marks the &lt;b&gt;cathode&lt;/b&gt; — the end current leaves by. Band toward the cap, never toward the panel.&lt;br&gt;&lt;br&gt;&lt;b&gt;Backwards gives no smoke and no heat.&lt;/b&gt; The cap just never charges. That is the only symptom, so check the band before suspecting the panel.&lt;br&gt;&lt;br&gt;&lt;b&gt;Confirm it, meter in diode mode:&lt;/b&gt;&lt;br&gt;red on plain end, black on band → &lt;b&gt;0.2-0.3 V&lt;/b&gt;&lt;br&gt;probes swapped → &lt;b&gt;OL / open&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Do this to both diodes before wiring anything.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="b1" vertex="1">
                    <mxGeometry x="800" y="710" width="340" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bn_order" value="&lt;b&gt;TEST ORDER — measure, then connect&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Each panel alone, unconnected.&lt;/b&gt; DC volts across its leads. Both should read within ~0.2 V of each other in the same light. A positive reading means red probe is on +.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Each panel alone, short-circuit current.&lt;/b&gt; Meter in current mode straight across the leads — safe, a panel is current-limited by physics. Write both numbers down.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Both panels, both diodes, cap. No board.&lt;/b&gt; Charge current should be close to the &lt;i&gt;sum&lt;/i&gt; of the two Isc figures. Near one panel&#39;s figure = a diode is backwards.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Cover one panel.&lt;/b&gt; Current should drop by that panel&#39;s share and no further. That is the two-diode design doing its job.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Then the board&lt;/b&gt;, cap already above 4.5 V." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="b1" vertex="1">
                    <mxGeometry x="1160" y="710" width="340" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="bn_never" value="&lt;b&gt;NEVER DO THIS&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Panel to the 3V3 pin&lt;/b&gt; — 6.5 V kills the C3, the BME280 and the e-paper at once; the panel only ever touches &lt;b&gt;5V&lt;/b&gt;, and only through a diode.&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Panel and USB together&lt;/b&gt; — unplug USB before running from solar; the diode protects the panel, but the SuperMini has no VBUS diode, so a lit panel back-feeds the USB host.&lt;br&gt;&lt;b&gt;Panels in series&lt;/b&gt; — ~13 V straight through a 5.5 V cap.&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Panels + to + without diodes&lt;/b&gt; — see the orange box.&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Cap backwards&lt;/b&gt; — supercaps are polarised; marked lead to VCAP +, other lead to GND." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="1030" width="1420" height="120" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="BENCH TEST — cap and load" id="bench-cap">
        <mxGraphModel dx="1513" dy="1125" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1220" math="0" shadow="0">
            <root>
                <mxCell id="c0"/>
                <mxCell id="c1" parent="c0"/>
                <mxCell id="ctitle" value="BENCH TEST — supercap, dummy load and where to put the probes" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" parent="c1" vertex="1">
                    <mxGeometry x="50" y="25" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="csub" value="Stage 2. Panels and diodes already verified at 4.8 V. Now: does the cap hold that, and how long does it run a load?" style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" parent="c1" vertex="1">
                    <mxGeometry x="50" y="60" width="1100" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="crule" value="&lt;b&gt;ONE METER, TWO READINGS&lt;/b&gt;&amp;nbsp;&amp;nbsp; Volts across the &lt;b&gt;cap&lt;/b&gt; = state of charge.&amp;nbsp;&amp;nbsp; Volts across the &lt;b&gt;load resistor&lt;/b&gt; = current, since &lt;b&gt;I = V / R&lt;/b&gt;.&amp;nbsp;&amp;nbsp; The resistor is already a known shunt — you never need the meter&#39;s current mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=16;" parent="c1" vertex="1">
                    <mxGeometry x="50" y="100" width="1450" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="cpanels" value="&lt;b&gt;PANELS + D1 / D2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;verified stage 1&lt;br&gt;4.8 V after the diodes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="c1" vertex="1">
                    <mxGeometry x="80" y="200" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="cw_p_link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="280" y="245" as="sourcePoint"/>
                        <mxPoint x="305" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="clink1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" parent="c1" vertex="1">
                    <mxGeometry x="305" y="240" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="clink2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" parent="c1" vertex="1">
                    <mxGeometry x="345" y="240" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="cw_link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#999999;endArrow=none;dashed=1;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="315" y="245" as="sourcePoint"/>
                        <mxPoint x="345" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="clinklabel" value="&lt;b&gt;REMOVABLE LINK&lt;/b&gt;&lt;br&gt;pull it for the leakage&lt;br&gt;and discharge tests" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#b85450;" parent="c1" vertex="1">
                    <mxGeometry x="255" y="258" width="150" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="cw_link_bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#d79b00;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
