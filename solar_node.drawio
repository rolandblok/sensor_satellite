                    </mxGeometry>
                </mxCell>
                <mxCell id="cnode" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="c1" vertex="1">
                    <mxGeometry x="515" y="240" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="cvcaplabel" value="&lt;b&gt;VCAP +&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;fontColor=#1f4e79;" parent="c1" vertex="1">
                    <mxGeometry x="535" y="208" width="120" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cw_bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="520" y="245" as="sourcePoint"/>
                        <mxPoint x="520" y="340" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ccap" value="&lt;b&gt;SUPERCAP&lt;/b&gt;&lt;br&gt;5.5 V / 4 F&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;marked lead up&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="c1" vertex="1">
                    <mxGeometry x="420" y="340" width="200" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="ccapplus" value="&lt;b&gt;+&lt;/b&gt; to VCAP" style="text;html=1;fontSize=12;fontColor=#cc0000;fontStyle=1;align=left;" parent="c1" vertex="1">
                    <mxGeometry x="632" y="336" width="110" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="ccapminus" value="&lt;b&gt;−&lt;/b&gt; to GND&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;— straight down, nothing in the way&lt;/font&gt;" style="text;html=1;fontSize=12;fontColor=#000000;fontStyle=1;align=left;" parent="c1" vertex="1">
                    <mxGeometry x="632" y="456" width="350" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cw_capgnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="520" y="470" as="sourcePoint"/>
                        <mxPoint x="520" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cw_bus_ldo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#6c8ebf;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="520" y="245" as="sourcePoint"/>
                        <mxPoint x="760" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cldo" value="&lt;b&gt;HT7533&lt;/b&gt;&amp;nbsp; 3.3 V LDO&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;1 GND · 2 VIN · 3 VOUT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;1 µF in · 1 µF out&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="c1" vertex="1">
                    <mxGeometry x="760" y="205" width="220" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cw_ldognd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="790" y="295" as="sourcePoint"/>
                        <mxPoint x="790" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cldopins" value="&lt;b&gt;HT7533 TO-92 — VERIFIED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;flat face toward you, pins down&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;3&quot;&gt;&amp;nbsp;&amp;nbsp;1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;3&lt;br&gt;&amp;nbsp;&lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;VIN&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;VOUT&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&lt;br&gt;&amp;nbsp;rail&amp;nbsp;&amp;nbsp;VCAP&amp;nbsp;&amp;nbsp;load&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=top;spacingTop=8;" parent="c1" vertex="1">
                    <mxGeometry x="880" y="320" width="300" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="c3v3" value="&lt;b&gt;3V3&lt;/b&gt;" style="text;html=1;fontSize=12;align=left;fontColor=#255d1c;" parent="c1" vertex="1">
                    <mxGeometry x="1030" y="218" width="60" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cw_ldores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="980" y="245" as="sourcePoint"/>
                        <mxPoint x="1150" y="245" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cres" value="&lt;b&gt;DUMMY LOAD&lt;/b&gt;&lt;br&gt;130 Ω&amp;nbsp; 0.25 W&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;= 25.4 mA&lt;br&gt;≈ ESP active&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="c1" vertex="1">
                    <mxGeometry x="1150" y="205" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cw_resgnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1240" y="295" as="sourcePoint"/>
                        <mxPoint x="1240" y="650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cmeterA" value="V" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=28;fontStyle=1;" parent="c1" vertex="1">
                    <mxGeometry x="200" y="370" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cw_mA_red" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="272" y="390" as="sourcePoint"/>
                        <mxPoint x="420" y="375" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cw_mA_blk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#000000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="272" y="432" as="sourcePoint"/>
                        <mxPoint x="420" y="450" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cmeterAlab" value="&lt;b&gt;PROBE 1&lt;/b&gt;&amp;nbsp; DCV across the cap&lt;br&gt;= state of charge" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="c1" vertex="1">
                    <mxGeometry x="140" y="458" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cmeterB" value="V" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=28;fontStyle=1;" parent="c1" vertex="1">
                    <mxGeometry x="1390" y="210" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cw_mB_red" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#cc0000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1330" y="222" as="sourcePoint"/>
                        <mxPoint x="1398" y="232" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cw_mB_blk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#000000;endArrow=none;" parent="c1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1330" y="278" as="sourcePoint"/>
                        <mxPoint x="1398" y="268" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="cmeterBlab" value="&lt;b&gt;PROBE 2&lt;/b&gt;&amp;nbsp; DCV across R&lt;br&gt;&lt;b&gt;I = V / R&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;3.3 V / 130 Ω = 25.4 mA&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="c1" vertex="1">
                    <mxGeometry x="1340" y="298" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="cgnd" value="&lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; panel 1 −&amp;nbsp; ·&amp;nbsp; panel 2 −&amp;nbsp; ·&amp;nbsp; &lt;b&gt;supercap −&lt;/b&gt;&amp;nbsp; ·&amp;nbsp; LDO GND&amp;nbsp; ·&amp;nbsp; dummy load&amp;nbsp; ·&amp;nbsp; meter black probe&amp;nbsp;&amp;nbsp; — one node, plain copper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontSize=13;fontColor=#ffffff;align=left;spacingLeft=16;" parent="c1" vertex="1">
                    <mxGeometry x="80" y="650" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="cn_gnd" value="&lt;b&gt;WHERE THE MINUS GOES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Straight to &lt;b&gt;GND&lt;/b&gt; — the same node as everything else on the bench.&lt;br&gt;&lt;br&gt;GND is: panel 1 −, panel 2 −, supercap −, LDO GND, the bottom of the dummy load, your meter&#39;s black probe, and later the ESP&#39;s GND pin.&lt;br&gt;&lt;br&gt;&lt;b&gt;One node, joined by plain copper.&lt;/b&gt; No diode, no resistor, no switch anywhere in it.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Putting a shunt resistor in the ground leg to read current is tempting and wrong: every voltage in the circuit is referenced to that node, so a shunt there shifts all of them at once and corrupts every other reading. Measure across the load instead.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="c1" vertex="1">
                    <mxGeometry x="80" y="700" width="340" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cn_size" value="&lt;b&gt;SIZING THE DUMMY LOAD&lt;/b&gt;&lt;br&gt;&lt;br&gt;The resistor stands in for the ESP. Pick it for the current you want to imitate.&lt;br&gt;&lt;br&gt;&lt;b&gt;With the LDO fitted&lt;/b&gt; — resistor on 3V3:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;active&amp;nbsp; 25 mA → &lt;b&gt;130 Ω&lt;/b&gt; 0.25 W&lt;br&gt;refresh 45 mA → 68 Ω 0.5 W&lt;br&gt;sleep&amp;nbsp;&amp;nbsp; 50 µA → 68 kΩ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Without the LDO&lt;/b&gt; — resistor on VCAP at 4.6 V:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;active&amp;nbsp; 25 mA → 180 Ω 0.25 W&lt;br&gt;sleep&amp;nbsp;&amp;nbsp; 50 µA → 100 kΩ&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;The LDO version is the better test. A series regulator draws roughly its output current at its input, so the cap sees a &lt;b&gt;constant&lt;/b&gt; 22 mA all the way down. A bare resistor on VCAP gives an RC decay — current fades as the cap empties, which the ESP does not do.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="c1" vertex="1">
                    <mxGeometry x="440" y="700" width="340" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cn_three" value="&lt;b&gt;THE THREE MEASUREMENTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. CHARGE.&lt;/b&gt; Link in, panels lit, no load. Probe 1 every minute. Expect a straight ramp, then a knee, then a crawl as it nears the panel voltage.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. LEAKAGE.&lt;/b&gt; Charge full, &lt;b&gt;pull the link&lt;/b&gt;, no load. Watch the cap alone for a few hours. The cap is its own coulomb meter:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;I = C · dV/dt&lt;br&gt;&amp;nbsp;&amp;nbsp;at 4 F: 1 mV/hour ≈ 1.1 µA&lt;/font&gt;&lt;br&gt;&lt;br&gt;That measures the leakage floor of design note 7 with no ammeter at all.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;The meter is itself a load: 10 MΩ at 4.8 V draws 0.48 µA. Leave it connected throughout and subtract it, or probe only briefly.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. DISCHARGE.&lt;/b&gt; Link out, dummy load on. Time the fall 4.6 → 3.6 V, reading probe 2 as you go." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="c1" vertex="1">
                    <mxGeometry x="800" y="700" width="340" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cn_expect" value="&lt;b&gt;WHAT THE NUMBERS SHOULD BE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Discharge&lt;/b&gt;, LDO + 130 Ω, 4.6 → 3.6 V:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;expect ~157 s at ~25.4 mA&lt;/font&gt;&lt;br&gt;&lt;br&gt;That is design note 4 under test: 4 F × 1.0 V = 4 C, and 4 C / 25.4 mA = 157 s.&lt;br&gt;&lt;br&gt;&lt;b&gt;Capacitance&lt;/b&gt; falls straight out of the same run:&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;C = I · t / ΔV&lt;/font&gt;&lt;br&gt;Well under 4 F means the cap is not what the label claims — supercap tolerance is routinely −20 / +80 %.&lt;br&gt;&lt;br&gt;&lt;b&gt;ESR&lt;/b&gt;: watch for an instant step the moment the load connects. &lt;font face=&quot;Courier New&quot;&gt;step = I × ESR&lt;/font&gt;. A 200 mV step at 25.4 mA means ESR ≈ 8 Ω, which will brown out the e-paper refresh later.&lt;br&gt;&lt;br&gt;&lt;b&gt;LDO heat&lt;/b&gt;: (4.6 − 3.3) × 25.4 mA = 33 mW. Nothing to cool — but it is 28 % of the energy burnt as heat at a full cap, falling to 8 % at dropout. The buck-boost argument in miniature." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" parent="c1" vertex="1">
                    <mxGeometry x="1160" y="700" width="340" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="cn_never" value="&lt;b&gt;NEVER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Short a charged supercap.&lt;/b&gt; 4 F at 4.8 V is 46 J and tens of amps — it welds tweezers, vaporises thin wire and wrecks the cap. To empty it, hang a &lt;b&gt;100 Ω 2 W&lt;/b&gt; resistor across it and wait ~20 min. Never a screwdriver, never a wire link.&lt;br&gt;&lt;b&gt;Probe with the meter still in current mode.&lt;/b&gt; Leads left in the A jacks and touched across the cap is a dead short through the meter&#39;s shunt — blown fuse at best, and the cap can deliver far more than the fuse rating. Glance at the jacks before every probe.&lt;br&gt;&lt;b&gt;Leave the panels connected during a leakage or discharge test.&lt;/b&gt; You would be measuring charge minus drain, not either one. That is what the removable link is for." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="c1" vertex="1">
                    <mxGeometry x="80" y="1030" width="1420" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="LDO — TO-92 pinout" id="ldo-pinout">
        <mxGraphModel dx="1513" dy="1125" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
            <root>
                <mxCell id="p0"/>
                <mxCell id="p1" parent="p0"/>
                <mxCell id="ptitle" value="HT7333 / HT7533 — TO-92 pinout: find it, do not assume it" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" parent="p1" vertex="1">
                    <mxGeometry x="50" y="25" width="1100" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="psub" value="The package convention is fixed and safe to rely on. Which function sits on which pin is not — it takes two minutes to prove." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" parent="p1" vertex="1">
                    <mxGeometry x="50" y="60" width="1100" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="prule" value="&lt;b&gt;THE CONVENTION&lt;/b&gt;&amp;nbsp;&amp;nbsp; Hold the part with the &lt;b&gt;flat, printed face toward you&lt;/b&gt; and the &lt;b&gt;pins pointing down&lt;/b&gt;. Pins are then numbered &lt;b&gt;1, 2, 3 left to right&lt;/b&gt;. That is universal for TO-92 and is the one thing about this package you may assume." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=16;" parent="p1" vertex="1">
                    <mxGeometry x="50" y="100" width="1450" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="pfrontlab" value="&lt;b&gt;FRONT VIEW&lt;/b&gt; — flat face toward you" style="text;html=1;fontSize=13;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="100" y="192" width="230" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pfrontbody" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;FLAT FACE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cccccc&quot;&gt;printing is here&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;HT7333&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#000000;fontSize=13;" parent="p1" vertex="1">
                    <mxGeometry x="120" y="220" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="pfp1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="165" y="360" as="sourcePoint"/>
                        <mxPoint x="165" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pfp2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="215" y="360" as="sourcePoint"/>
                        <mxPoint x="215" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pfp3" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="265" y="360" as="sourcePoint"/>
                        <mxPoint x="265" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pfn1" value="&lt;b&gt;1&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="150" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pfn2" value="&lt;b&gt;2&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="200" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pfn3" value="&lt;b&gt;3&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="250" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pfcap" value="Pins point down, flat face toward you.&lt;br&gt;Numbering runs &lt;b&gt;1 - 2 - 3, left to right&lt;/b&gt;." style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="p1" vertex="1">
                    <mxGeometry x="100" y="460" width="230" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="pbacklab" value="&lt;b&gt;BACK VIEW&lt;/b&gt; — rounded side toward you" style="text;html=1;fontSize=13;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="400" y="192" width="240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pbackbody" value="&lt;font color=&quot;#ffffff&quot;&gt;&lt;b&gt;ROUNDED BACK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#cccccc&quot;&gt;no printing&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=45;whiteSpace=wrap;html=1;fillColor=#4d4d4d;strokeColor=#000000;fontSize=13;" parent="p1" vertex="1">
                    <mxGeometry x="425" y="220" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="pbp1" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="470" y="360" as="sourcePoint"/>
                        <mxPoint x="470" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pbp2" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="520" y="360" as="sourcePoint"/>
                        <mxPoint x="520" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pbp3" style="edgeStyle=none;rounded=0;html=1;strokeWidth=4;strokeColor=#999999;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="570" y="360" as="sourcePoint"/>
                        <mxPoint x="570" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pbn1" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;3&lt;/font&gt;&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="455" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pbn2" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;2&lt;/font&gt;&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="505" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pbn3" value="&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;1&lt;/font&gt;&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" parent="p1" vertex="1">
                    <mxGeometry x="555" y="428" width="30" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="pbcap" value="&lt;font color=&quot;#b85450&quot;&gt;Same part, seen from behind. &lt;b&gt;Left and right flip.&lt;/b&gt;&lt;br&gt;This is the single most common way people&lt;br&gt;destroy a TO-92 regulator.&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="p1" vertex="1">
                    <mxGeometry x="400" y="460" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="pfill" value="&lt;b&gt;THE RECORD&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#255d1c&quot;&gt;&lt;b&gt;HT7533 — datasheet + bench confirmed&lt;/b&gt;&lt;/font&gt;&lt;br&gt;flat face toward you, pins down:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;3&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 3&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;VIN&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;VOUT&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;|&lt;br&gt;&amp;nbsp;&amp;nbsp;rail&amp;nbsp;&amp;nbsp;VCAP&amp;nbsp;&amp;nbsp;load&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;HT7333 — NOT yet verified&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;3&quot;&gt;pin 1 = ______&amp;nbsp; 2 = ______&amp;nbsp; 3 = ______&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;HT73xx and HT75xx are different series. Do not carry the HT7533 result across — run the rig below on the HT7333 before powering it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="p1" vertex="1">
                    <mxGeometry x="710" y="192" width="380" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="pwhy" value="&lt;b&gt;WHY YOU CANNOT JUST LOOK IT UP FROM MEMORY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Three-terminal regulators in TO-92 do &lt;i&gt;not&lt;/i&gt; share a pinout. Same package, same three functions, different order:&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;78L05&amp;nbsp;&amp;nbsp;&amp;nbsp; GND on pin 2 (middle)&lt;br&gt;MCP1700&amp;nbsp; GND on pin 1 (end)&lt;/font&gt;&lt;br&gt;&lt;br&gt;Both are 3-pin TO-92 linear regulators. Wiring one as the other destroys it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Middle-pin GND is the more common arrangement&lt;/b&gt;, so it is a reasonable first guess — but the MCP1700 above is exactly the part this design originally specified, and it breaks that rule.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;A guess costs a destroyed part and an afternoon chasing a fault that is not in your circuit. The test below costs two minutes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="p1" vertex="1">
                    <mxGeometry x="1120" y="192" width="380" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="prigtitle" value="&lt;b&gt;THE SAFE IDENTIFICATION RIG&lt;/b&gt; — the 1 kΩ is what makes a wrong guess harmless" style="text;html=1;fontSize=15;align=left;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="562" width="800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="psrc" value="&lt;b&gt;5 V&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;USB or bench&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="110" y="618" width="110" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="pw1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#cc0000;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="220" y="640" as="sourcePoint"/>
                        <mxPoint x="300" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pres" value="&lt;b&gt;1 kΩ&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="300" y="620" width="90" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pw2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#cc0000;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="390" y="640" as="sourcePoint"/>
                        <mxPoint x="470" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pdut" value="&lt;b&gt;PART UNDER TEST&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;candidate VIN in&lt;br&gt;candidate GND down&lt;br&gt;third pin to the meter&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="p1" vertex="1">
                    <mxGeometry x="470" y="600" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="pw3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#82b366;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="650" y="640" as="sourcePoint"/>
                        <mxPoint x="730" y="640" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pmeter" value="V" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=28;fontStyle=1;" parent="p1" vertex="1">
                    <mxGeometry x="730" y="605" width="70" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="pw_srcg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="165" y="682" as="sourcePoint"/>
                        <mxPoint x="165" y="740" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pw_dutg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="690" as="sourcePoint"/>
                        <mxPoint x="560" y="740" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="pw_mg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#000000;endArrow=none;" parent="p1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="765" y="675" as="sourcePoint"/>
                        <mxPoint x="765" y="740" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="prigg" value="&lt;b&gt;GND&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;fontSize=12;fontColor=#ffffff;align=left;spacingLeft=12;" parent="p1" vertex="1">
                    <mxGeometry x="110" y="740" width="700" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="prigcap" value="&lt;b&gt;Reads 3.3 V → that assignment is correct.&lt;/b&gt; Reads 0 V, or roughly 5 V, or anything else → move to the next row of the table and try again.&lt;br&gt;&lt;br&gt;The 1 kΩ caps the current at about 5 mA whatever you connect where. That is far below anything that can damage a part rated for hundreds of mA, so a wrong guess costs you nothing but the ten seconds it takes to move a wire. &lt;b&gt;No load resistor is needed&lt;/b&gt; — the regulator&#39;s few µA of quiescent current is enough for it to regulate, and 5 mA through 1 kΩ is only a 5 mV drop, so the part still sees a full 5 V in." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" parent="p1" vertex="1">
                    <mxGeometry x="110" y="778" width="700" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="ptable" value="&lt;b&gt;SIX PERMUTATIONS — WORK DOWN THE LIST&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;3&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; pin1&amp;nbsp; pin2&amp;nbsp; pin3&amp;nbsp;&amp;nbsp; third pin reads&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ----&amp;nbsp; ----&amp;nbsp; ----&amp;nbsp;&amp;nbsp; ---------------&lt;br&gt;&amp;nbsp;1&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; ______&lt;br&gt;&amp;nbsp;2&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; ______&lt;br&gt;&amp;nbsp;3&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; &lt;b&gt;3.3 V ← HT7533&lt;/b&gt;&lt;br&gt;&amp;nbsp;4&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; ______&lt;br&gt;&amp;nbsp;5&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; ______&lt;br&gt;&amp;nbsp;6&amp;nbsp;&amp;nbsp; OUT&amp;nbsp;&amp;nbsp; VIN&amp;nbsp;&amp;nbsp; &lt;b&gt;GND&lt;/b&gt;&amp;nbsp;&amp;nbsp; ______&lt;/font&gt;&lt;br&gt;&lt;br&gt;Rows 1 and 2 are middle-pin GND, the commoner arrangement — a reasonable place to start.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;Though note the HT7533 turned out to be row 3&lt;/b&gt; — GND on an end pin, like the MCP1700 and unlike the 78L05. The heuristic would have cost two wasted tries here. It is a starting order, not a prediction.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Only one row can give 3.3 V. When you find it, stop, and write it into the record above.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="p1" vertex="1">
                    <mxGeometry x="870" y="562" width="630" height="356" as="geometry"/>
                </mxCell>
                <mxCell id="pfinal" value="&lt;b&gt;ONCE IT IS PROVEN&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Fit &lt;b&gt;1 µF from VIN to GND&lt;/b&gt; and &lt;b&gt;1 µF from VOUT to GND&lt;/b&gt;, ceramic, close to the pins. Without an output capacitor an LDO can oscillate, and it shows up as inexplicable brownouts rather than as an obvious fault — you would blame the supercap.&amp;nbsp;&amp;nbsp;&amp;nbsp; Then VIN to VCAP, GND to the ground rail, VOUT to the &lt;b&gt;130 Ω&lt;/b&gt; dummy load (25.4 mA) and later to the SuperMini&#39;s &lt;b&gt;3V3&lt;/b&gt; pin." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" parent="p1" vertex="1">
                    <mxGeometry x="80" y="945" width="1420" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>