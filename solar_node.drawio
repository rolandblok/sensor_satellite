                <mxCell id="bd1a" value="&lt;b&gt;A&lt;/b&gt; plain end&lt;br&gt;&lt;font color=&quot;#cc0000&quot;&gt;← panel 1 +&lt;/font&gt;" style="text;html=1;fontSize=11;align=center;verticalAlign=top;" parent="b1" vertex="1">
